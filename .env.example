# =============================================================================
# cerne-commerce - Variáveis de Ambiente
# Copie este arquivo para .env para desenvolvimento local (nunca commite o .env)
# =============================================================================

# --- Perfil da aplicação ---
# Valores: dev | hml | prod
# ATENÇÃO: o default (sem esta variável) é "dev" — permissivo. Um deploy que a esqueça sobe
# com H2 em memória, CORS '*' e seed de senha versionada. O DevStartupValidator bloqueia o
# boot se detectar infraestrutura remota sob o perfil dev (PLAT-C032).
SPRING_PROFILES_ACTIVE=dev

# Libera o boot em perfil dev mesmo com DB_URL/CORS_ALLOWED_ORIGINS apontando para
# infraestrutura remota. Use só se o ambiente local realmente usa um banco compartilhado.
# DEV_ALLOW_REMOTE_INFRA=true

# --- JWT ---
# Chave secreta para assinar tokens JWT (mínimo 256-bit / 32 chars para HS256)
JWT_SECRET=troque-para-uma-chave-segura-de-256-bits-em-producao
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- Banco de dados (obrigatório para perfis hml/prod) ---
DB_URL=jdbc:postgresql://localhost:5432/security
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- CORS ---
# Em dev o padrão já é permissivo (*); restrinja em hml/prod
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type

# --- Rate limiting de login ---
LOGIN_RATE_WINDOW_SECONDS=60
LOGIN_RATE_MAX_REQUESTS=10

# --- Lockout por usuário ---
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15

# --- Email (Resend) ---
# Obtenha sua API key em https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Sistema <noreply@seudominio.com>
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_FRONTEND_URL=https://seudominio.com/auth/verify-email
# Base do painel usada nos links dos e-mails (ex.: "Abrir PDV", "Abrir estoque")
EMAIL_APP_BASE_URL=https://seudominio.com
# Mailpit (dev/hml): caixa de entrada que o admin embute em Integrações > Caixa de teste.
# Os composes de dev/hml já definem; só mude se a UI do Mailpit estiver em outro endereço.
# MAILPIT_UI_URL=http://localhost:8026

# --- Gateway de pagamento InfinitePay (ECM-F004) ---
# handle = seu InfiniteTag (sem o $), configurado em checkout.infinitepay.io. Sem API key: os
# endpoints /links e /payment_check não exigem uma (confirmado na documentação pública deles).
PAYMENT_GATEWAY_PROVIDER=infinitepay
INFINITEPAY_HANDLE=seu-handle
INFINITEPAY_REDIRECT_URL=https://seudominio.com/pedidos
INFINITEPAY_WEBHOOK_URL=https://api.seudominio.com/webhooks/payments/infinitepay

# --- OAuth2 Google ---
# Obtenha em https://console.cloud.google.com/apis/credentials (tipo: Aplicativo da Web)
# Necessário no perfil hml — sem isso o HmlStartupValidator bloqueia a inicialização
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Scheduler ---
# Cron para limpeza de refresh tokens (padrao: 03:00 diario)
REFRESH_TOKEN_CLEANUP_CRON=0 0 3 * * *

# --- Docker Compose (docker-compose.yml, stack hml local) ---
# Estas variáveis são lidas tanto pela aplicação (via dotenv-java) quanto pelo
# próprio `docker compose up` (que carrega .env automaticamente). Gere valores
# aleatórios reais para TOTP_ENCRYPTION_KEY/JWT_SECRET, nunca reutilize os deste exemplo.
#
# TOTP_ENCRYPTION_KEY: AES-256 em Base64 — exatamente 44 caracteres. Gere com:
#   openssl rand -base64 32
# Em prod não há mais fallback (PLAT-C028): sem esta variável o compose falha. O
# ProdStartupValidator também rejeita as duas chaves que já estiveram hardcoded no
# repositório, mesmo que sejam copiadas do histórico do git.
# Trocar esta chave invalida os secrets TOTP já gravados — quem tiver 2FA ativo perde o
# segundo fator e precisa recadastrá-lo. Rotacione antes de haver usuários com 2FA.
TOTP_ENCRYPTION_KEY=troque-para-uma-chave-aes-256-base64-em-producao
REDIS_PASSWORD=troque-para-uma-senha-redis-segura
